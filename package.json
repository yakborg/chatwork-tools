{
  "name": "chatwork-tools",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "cli": "tsx src/cli/main.ts",
    "mcp": "tsx src/mcp/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "tsup",
    "build:exe": "pkg dist/mcp/server.cjs --targets node22-win-x64 --public --public-packages \"*\" --output bin/chatwork-mcp.exe"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "@yao-pkg/pkg": "^6.20.0",
    "tsup": "^8.5.1",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  }
}
